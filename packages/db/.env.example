# Supabase & PostgreSQL Connection Configuration for FALCON

# Transaction pooler connection string (port 6543)
# Recommended for serverless / pooled application queries
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Direct PostgreSQL connection string (port 5432)
# Recommended for migrations and administrative tasks
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Supabase API URL and keys
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Connection pool & client settings
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=20
