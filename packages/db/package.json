{
  "name": "@falcon/db",
  "version": "0.1.0",
  "description": "PostgreSQL & Supabase persistence layer with Drizzle ORM for FALCON",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@falcon/domain": "workspace:*",
    "@supabase/supabase-js": "^2.48.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.2"
  }
}
